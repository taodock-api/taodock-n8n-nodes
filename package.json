{
  "name": "n8n-nodes-taodock",
  "version": "0.1.3",
  "description": "TaoDock AI actions for n8n workflows",
  "license": "MIT",
  "homepage": "https://docs.taodock.com",
  "keywords": [
    "n8n-community-node-package",
    "taodock",
    "ai",
    "automation"
  ],
  "author": {
    "name": "TaoDock",
    "email": "support@taodock.com",
    "url": "https://taodock.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/taodock-api/taodock-n8n-nodes.git"
  },
  "scripts": {
    "build": "n8n-node build",
    "build:watch": "tsc --watch",
    "dev": "n8n-node dev",
    "lint": "n8n-node lint",
    "lint:fix": "n8n-node lint --fix",
    "test": "npm run build && node --test test/**/*.test.cjs",
    "typecheck": "tsc --noEmit",
    "release": "n8n-node release",
    "prepublishOnly": "n8n-node prerelease"
  },
  "files": [
    "dist",
    "PRIVACY.md",
    "!dist/tsconfig.tsbuildinfo"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "strict": true,
    "credentials": [
      "dist/credentials/TaoDockApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/TaoDock/Taodock.node.js"
    ]
  },
  "devDependencies": {
    "@n8n/node-cli": "0.55.5",
    "eslint": "9.39.4",
    "n8n-workflow": "2.16.0",
    "prettier": "3.8.3",
    "release-it": "20.2.0",
    "typescript": "5.9.3"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  },
  "engines": {
    "node": ">=22.0"
  }
}
